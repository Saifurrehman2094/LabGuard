# Live Database API - Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

NODE_ENV=development
PORT=5000

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab_guard_cloud
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=8h

# For production, use strong random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================================================
# CLOUD STORAGE (Optional - S3 for evidence files)
# ============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=lab-guard-evidence

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

CORS_ORIGIN=*

# For production, restrict to specific domains:
# CORS_ORIGIN=http://localhost:3000,http://lab-guard.school.com

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=info

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================

# Analytics computation interval (milliseconds)
ANALYTICS_COMPUTE_INTERVAL=3600000

# Backup interval (milliseconds)
BACKUP_INTERVAL=86400000
